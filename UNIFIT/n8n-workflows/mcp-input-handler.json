{
  "name": "MCP Input Handler - Simple",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mcp-input",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook Input",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "id": "webhook-input"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3003/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message\": \"{{$json.body.message}}\",\n  \"userId\": \"{{$json.body.userId}}\"\n}",
        "options": {}
      },
      "name": "AI Orchestrator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300],
      "id": "ai-orchestrator"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{JSON.stringify($json)}}",
        "options": {}
      },
      "name": "Respond Output",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [650, 300],
      "id": "respond-output"
    }
  ],
  "connections": {
    "Webhook Input": {
      "main": [[{"node": "AI Orchestrator", "type": "main", "index": 0}]]
    },
    "AI Orchestrator": {
      "main": [[{"node": "Respond Output", "type": "main", "index": 0}]]
    }
  }
}
