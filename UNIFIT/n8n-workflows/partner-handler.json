{
  "name": "Partner Handler - Simple",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "partner-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook Partner",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "id": "webhook-partner"
    },
    {
      "parameters": {
        "functionCode": "// Verificar firma HMAC simplificada\nconst crypto = require('crypto');\nconst signature = $json.headers['x-unifit-signature'];\nconst secret = 'partner-secret-key';\nconst payload = JSON.stringify($json.body);\n\n// Calcular firma esperada\nconst expected = crypto.createHmac('sha256', secret).update(payload).digest('hex');\n\nreturn {\n  isValid: signature === expected,\n  data: $json.body\n};"
      },
      "name": "Verify HMAC",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300],
      "id": "verify-hmac"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.isValid}}",
              "value2": true
            }
          ]
        }
      },
      "name": "Is Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 300],
      "id": "is-valid"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/partner-events",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify($json.data)}}",
        "options": {}
      },
      "name": "Execute Business Action",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [850, 200],
      "id": "business-action"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\": \"ACK\"}",
        "options": {}
      },
      "name": "Respond ACK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1050, 200],
      "id": "respond-ack"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"error\": \"Invalid Signature\"}",
        "options": {
          "responseCode": 401
        }
      },
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 400],
      "id": "respond-error"
    }
  ],
  "connections": {
    "Webhook Partner": {
      "main": [[{"node": "Verify HMAC", "type": "main", "index": 0}]]
    },
    "Verify HMAC": {
      "main": [[{"node": "Is Valid?", "type": "main", "index": 0}]]
    },
    "Is Valid?": {
      "main": [
        [{"node": "Execute Business Action", "type": "main", "index": 0}],
        [{"node": "Respond Error", "type": "main", "index": 0}]
      ]
    },
    "Execute Business Action": {
      "main": [[{"node": "Respond ACK", "type": "main", "index": 0}]]
    }
  }
}
