import { Injectable, NotFoundException } from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { Repository } from 'typeorm';
import { Reserva } from '../entities/reserva.entity';

@Injectable()
export class ReservaService {
  constructor(
    @InjectRepository(Reserva)
    private reservaRepository: Repository<Reserva>,
  ) {}

  // Basic query - just return all reservas
  async findAll(): Promise<Reserva[]> {
    return this.reservaRepository.find({
      order: { fecha: 'DESC' as any },
    });
  }

  async findOne(id: string): Promise<Reserva> {
    const reserva = await this.reservaRepository.findOne({
      where: { id } as any,
    });

    if (!reserva) {
      throw new NotFoundException(`Reserva con ID ${id} no encontrada`);
    }

    return reserva;
  }

  // Simplified - no complex reporting features
  async findByFilter(filter: any): Promise<Reserva[]> {
    const where: any = {};
    
    if (filter?.usuarioId) {
      where.usuarioId = filter.usuarioId;
    }
    
    if (filter?.estado) {
      where.estado = filter.estado;
    }

    return this.reservaRepository.find({
      where,
      order: { fecha: 'DESC' as any },
    });
  }
}
