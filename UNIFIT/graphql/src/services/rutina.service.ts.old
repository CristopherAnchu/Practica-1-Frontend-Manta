import { Injectable, NotFoundException } from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { Repository } from 'typeorm';
import { Rutina } from '../entities/rutina.entity';

@Injectable()
export class RutinaService {
  constructor(
    @InjectRepository(Rutina)
    private rutinaRepository: Repository<Rutina>,
  ) {}

  async findAll(): Promise<Rutina[]> {
    return this.rutinaRepository.find({
      order: { titulo: 'ASC' as any },
    });
  }

  async findOne(id: string): Promise<Rutina> {
    const rutina = await this.rutinaRepository.findOne({
      where: { id } as any,
    });

    if (!rutina) {
      throw new NotFoundException(`Rutina con ID ${id} no encontrada`);
    }

    return rutina;
  }

  async findByFilter(filter: any): Promise<Rutina[]> {
    const where: any = {};
    
    if (filter?.usuarioId) {
      where.usuarioId = filter.usuarioId;
    }

    return this.rutinaRepository.find({ where });
  }
}
